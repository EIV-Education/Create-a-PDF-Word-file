# Copy to .env and fill in.

PORT=4000
NODE_ENV=development

# Where the local JSON datastore and uploaded/generated files live.
DATA_DIR=./data
FILES_DIR=./storage-files

# Optional: pin the webhook API key instead of letting the server
# generate+store a random one on first run. Value is shown/regeneratable
# from the Settings page either way.
WEBHOOK_API_KEY=

# Lark/Feishu custom app credentials (Developer Console -> your app ->
# Credentials & Basic Info). Use https://open.larksuite.com for Lark
# (global) or https://open.feishu.cn for Feishu (China).
LARK_DOMAIN=https://open.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=

# LibreOffice binary used for docx -> pdf conversion.
SOFFICE_BIN=soffice
PDF_CONVERT_TIMEOUT_MS=60000

# Image compression defaults (per-mapping toggle overrides these).
IMAGE_COMPRESSION_DEFAULT=true
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=78

CORS_ORIGIN=*
DEFAULT_LOCALE=en
