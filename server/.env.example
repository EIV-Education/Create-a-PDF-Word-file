# Copy to .env and fill in.

PORT=4000
NODE_ENV=development

# Where the local JSON datastore and uploaded/generated files live.
DATA_DIR=./data
FILES_DIR=./storage-files

# Optional: pin the webhook API key instead of letting the server
# generate+store a random one on first run. Value is shown/regeneratable
# from the Settings page either way.
WEBHOOK_API_KEY=

# Lark/Feishu custom app credentials (Developer Console -> your app ->
# Credentials & Basic Info). Use https://open.larksuite.com for Lark
# (global) or https://open.feishu.cn for Feishu (China).
LARK_DOMAIN=https://open.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=

# Optional: App Token of a Base your app can write to, used to store
# uploaded templates + saved field mappings as Base records instead of
# local files. Recommended for hosts without a persistent disk (e.g.
# Render's Free tier) - see docs/DEPLOY_RENDER.md. Leave blank to store
# them locally under DATA_DIR/FILES_DIR instead.
LARK_CONFIG_APP_TOKEN=

# How long generated .docx/.pdf files stick around on this server before
# being swept away. They're only kept for the UI's immediate "download"
# link — the permanent copy is whatever Lark attachment field the mapping
# writes back to. Safe to keep short.
OUTPUT_FILE_TTL_HOURS=24

# LibreOffice binary used for docx -> pdf conversion.
SOFFICE_BIN=soffice
PDF_CONVERT_TIMEOUT_MS=60000

# Image compression defaults (per-mapping toggle overrides these).
IMAGE_COMPRESSION_DEFAULT=true
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=78

CORS_ORIGIN=*
DEFAULT_LOCALE=en
